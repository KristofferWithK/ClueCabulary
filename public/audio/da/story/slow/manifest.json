{
  "entries": {
    "0-000": {
      "id": "story:0:0",
      "text": "Solen står op over Sønderborg, og en fugl synger i et stort træ.",
      "stamp": "dd6039a269914399",
      "bytes": 28800,
      "at": "2026-08-20T16:57:22.890Z"
    },
    "0-001": {
      "id": "story:0:1",
      "text": "Huset er hvidt, og døren er rød.",
      "stamp": "b2a1af55dc75a377",
      "bytes": 18144,
      "at": "2026-08-20T16:57:23.566Z"
    },
    "0-002": {
      "id": "story:0:2",
      "text": "Der er et lille køkken med et bord, en stol og en gammel lampe.",
      "stamp": "db37f1d5e6db1b98",
      "bytes": 30144,
      "at": "2026-08-20T16:57:24.370Z"
    },
    "0-003": {
      "id": "story:0:3",
      "text": "Mor laver mad, mens far drikker kaffe ved vinduet.",
      "stamp": "f95fba57a9788ce3",
      "bytes": 19968,
      "at": "2026-08-20T16:57:25.146Z"
    },
    "0-004": {
      "id": "story:0:4",
      "text": "Barnet spiser et æble og drikker mælk.",
      "stamp": "eb26c4a9eecdfcaa",
      "bytes": 18720,
      "at": "2026-08-20T16:57:25.860Z"
    },
    "0-005": {
      "id": "story:0:5",
      "text": "På bordet står ost, smør, salt og et æg.",
      "stamp": "57a6e0753606b1e6",
      "bytes": 27168,
      "at": "2026-08-20T16:57:26.592Z"
    },
    "0-006": {
      "id": "story:0:6",
      "text": "Hunden løber ud ad døren, mens en kat sover stadig på en seng.",
      "stamp": "b40fd233c86da1b2",
      "bytes": 25632,
      "at": "2026-08-20T16:57:27.622Z"
    },
    "0-007": {
      "id": "story:0:7",
      "text": "Deres værelse er lille, men vinduet er stort.",
      "stamp": "16a3d65699ac7a0e",
      "bytes": 20256,
      "at": "2026-08-20T16:57:28.336Z"
    },
    "0-008": {
      "id": "story:0:8",
      "text": "Pigen har en blomst i hånden, og drengen har mistet en tand.",
      "stamp": "9af7fa98c079e7a9",
      "bytes": 22656,
      "at": "2026-08-20T16:57:29.076Z"
    },
    "0-009": {
      "id": "story:0:9",
      "text": "Hun har langt hår, en lille næse og en glad mund.",
      "stamp": "faac72520aea7187",
      "bytes": 23424,
      "at": "2026-08-20T16:57:29.806Z"
    },
    "0-010": {
      "id": "story:0:10",
      "text": "Han lukker det ene øje og sætter en hat på hovedet.",
      "stamp": "c27f76aa28bfcc3e",
      "bytes": 17376,
      "at": "2026-08-20T16:57:30.610Z"
    },
    "0-011": {
      "id": "story:0:11",
      "text": "Katten sidder ved hans ben, mens han har ondt i en fod.",
      "stamp": "20392f396772d770",
      "bytes": 21024,
      "at": "2026-08-20T16:57:31.360Z"
    },
    "0-012": {
      "id": "story:0:12",
      "text": "Drengen har en bold under armen, og faren drikker en øl.",
      "stamp": "3aed523da189c5cb",
      "bytes": 21312,
      "at": "2026-08-20T16:57:32.083Z"
    },
    "0-013": {
      "id": "story:0:13",
      "text": "Pigen peger med en finger mod et sort fly på en klar himmel.",
      "stamp": "b428ab95611524ff",
      "bytes": 31008,
      "at": "2026-08-20T16:57:32.896Z"
    },
    "0-014": {
      "id": "story:0:14",
      "text": "Hjertet banker, fordi familien skal rejse i dag.",
      "stamp": "37e3b1133e23de5a",
      "bytes": 22944,
      "at": "2026-08-20T16:57:33.616Z"
    },
    "0-015": {
      "id": "story:0:15",
      "text": "De går ned ad en gade midt i en gammel by.",
      "stamp": "5940fac9e8834c0c",
      "bytes": 18720,
      "at": "2026-08-20T16:57:34.305Z"
    },
    "0-016": {
      "id": "story:0:16",
      "text": "En ung kvinde og en gammel mand venter ved en kirke.",
      "stamp": "314b29125e3d4cda",
      "bytes": 22944,
      "at": "2026-08-20T16:57:35.062Z"
    },
    "0-017": {
      "id": "story:0:17",
      "text": "I en butik køber de kød, fisk og grøntsager.",
      "stamp": "7ca31e857561d4e1",
      "bytes": 21600,
      "at": "2026-08-20T16:57:35.734Z"
    },
    "0-018": {
      "id": "story:0:18",
      "text": "De tager også en kartoffel, sukker og en stor kage.",
      "stamp": "c749d3aac7db2269",
      "bytes": 29664,
      "at": "2026-08-20T16:57:36.639Z"
    },
    "0-019": {
      "id": "story:0:19",
      "text": "Far henter penge i en bank, fordi han vil købe en bog.",
      "stamp": "87fbd901417c01b1",
      "bytes": 24768,
      "at": "2026-08-20T16:57:37.403Z"
    },
    "0-020": {
      "id": "story:0:20",
      "text": "Mor arbejder på et hospital, men i dag har hun fri.",
      "stamp": "d00a6b091b549076",
      "bytes": 23232,
      "at": "2026-08-20T16:57:38.248Z"
    },
    "0-021": {
      "id": "story:0:21",
      "text": "Hendes bror er lærer på en skole.",
      "stamp": "b5d08f60b8e4ef78",
      "bytes": 13632,
      "at": "2026-08-20T16:57:38.854Z"
    },
    "0-022": {
      "id": "story:0:22",
      "text": "Hans søster kører en rød bil, og hendes søn har en cykel.",
      "stamp": "ca00859c786dc778",
      "bytes": 26112,
      "at": "2026-08-20T16:57:39.821Z"
    },
    "0-023": {
      "id": "story:0:23",
      "text": "En hest står i en park ved vandet.",
      "stamp": "448be32fc528f3bb",
      "bytes": 15264,
      "at": "2026-08-20T16:57:40.460Z"
    },
    "0-024": {
      "id": "story:0:24",
      "text": "Deres datter og en ven læser en bog, hvis det regner.",
      "stamp": "0dd8f7afc9bdf81e",
      "bytes": 22080,
      "at": "2026-08-20T16:57:41.148Z"
    },
    "0-025": {
      "id": "story:0:25",
      "text": "En aften i sidste uge faldt der sne over hele byen.",
      "stamp": "c75a22f70edc2fcd",
      "bytes": 20256,
      "at": "2026-08-20T16:57:41.854Z"
    },
    "0-026": {
      "id": "story:0:26",
      "text": "Nu venter et tog, og en bus kører forbi.",
      "stamp": "dddc9ff43d40e3cb",
      "bytes": 18720,
      "at": "2026-08-20T16:57:42.471Z"
    },
    "0-027": {
      "id": "story:0:27",
      "text": "Fra vinduet ser de stranden og et stort hav.",
      "stamp": "0e8e821eb52aa0fb",
      "bytes": 19776,
      "at": "2026-08-20T16:57:43.392Z"
    },
    "0-028": {
      "id": "story:0:28",
      "text": "Det bliver nat, og man kan se månen og en klar stjerne.",
      "stamp": "0d301bae079c616d",
      "bytes": 28032,
      "at": "2026-08-20T16:57:44.192Z"
    },
    "0-029": {
      "id": "story:0:29",
      "text": "De elsker at rejse, selvom rejsen er lang.",
      "stamp": "f4a11f51d53e25e5",
      "bytes": 18144,
      "at": "2026-08-20T16:57:44.831Z"
    },
    "0-030": {
      "id": "story:0:30",
      "text": "Casey er glad, fordi kufferten er fuld af ord.",
      "stamp": "1743824c3b4e349a",
      "bytes": 19968,
      "at": "2026-08-20T16:57:45.440Z"
    }
  },
  "provider": "google",
