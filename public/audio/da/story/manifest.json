{
  "entries": {
    "0-000": {
      "id": "story:0:0",
      "text": "Solen står op over Sønderborg, og en fugl synger i et stort træ.",
      "stamp": "f158beb4f81eed6f",
      "bytes": 17856,
      "at": "2026-08-21T00:35:36.952Z"
    },
    "0-001": {
      "id": "story:0:1",
      "text": "Huset er hvidt, og døren er rød.",
      "stamp": "7e389c6084eb9e02",
      "bytes": 9984,
      "at": "2026-08-21T00:35:37.655Z"
    },
    "0-002": {
      "id": "story:0:2",
      "text": "Der er et lille køkken med et bord, en stol og en gammel lampe.",
      "stamp": "185ab13ba22ecc8a",
      "bytes": 19104,
      "at": "2026-08-21T00:35:38.468Z"
    },
    "0-003": {
      "id": "story:0:3",
      "text": "Mor laver mad, mens far drikker kaffe ved vinduet.",
      "stamp": "cae9737ce81e677f",
      "bytes": 14304,
      "at": "2026-08-21T00:35:39.367Z"
    },
    "0-004": {
      "id": "story:0:4",
      "text": "Barnet spiser et æble og drikker mælk.",
      "stamp": "9f1cc823359a4e6f",
      "bytes": 10272,
      "at": "2026-08-21T00:35:40.373Z"
    },
    "0-005": {
      "id": "story:0:5",
      "text": "På bordet står ost, smør, salt og et æg.",
      "stamp": "e0b7abc3e0a3d9b3",
      "bytes": 17664,
      "at": "2026-08-21T00:35:41.141Z"
    },
    "0-006": {
      "id": "story:0:6",
      "text": "Hunden løber ud ad døren, mens en kat sover stadig på en seng.",
      "stamp": "68adc0ced4c90d77",
      "bytes": 14304,
      "at": "2026-08-21T00:35:42.021Z"
    },
    "0-007": {
      "id": "story:0:7",
      "text": "Deres værelse er lille, men vinduet er stort.",
      "stamp": "2ed9fdf69ade50a1",
      "bytes": 12192,
      "at": "2026-08-21T00:35:42.540Z"
    },
    "0-008": {
      "id": "story:0:8",
      "text": "Pigen har en blomst i hånden, og drengen har mistet en tand.",
      "stamp": "2757bdca681bd535",
      "bytes": 15456,
      "at": "2026-08-21T00:35:43.340Z"
    },
    "0-009": {
      "id": "story:0:9",
      "text": "Hun har langt hår, en lille næse og en glad mund.",
      "stamp": "396a1edb07b7f41f",
      "bytes": 14496,
      "at": "2026-08-21T00:35:44.265Z"
    },
    "0-010": {
      "id": "story:0:10",
      "text": "Han lukker det ene øje og sætter en hat på hovedet.",
      "stamp": "133046f2fd706921",
      "bytes": 14016,
      "at": "2026-08-21T00:35:45.137Z"
    },
    "0-011": {
      "id": "story:0:11",
      "text": "Katten sidder ved hans ben, mens han har ondt i en fod.",
      "stamp": "2b1d81bb673b34ce",
      "bytes": 13824,
      "at": "2026-08-21T00:35:46.011Z"
    },
    "0-012": {
      "id": "story:0:12",
      "text": "Drengen har en bold under armen, og faren drikker en øl.",
      "stamp": "a2a1e52948fbc795",
      "bytes": 12864,
      "at": "2026-08-21T00:35:46.903Z"
    },
    "0-013": {
      "id": "story:0:13",
      "text": "Pigen peger med en finger mod et sort fly på en klar himmel.",
      "stamp": "18847ed363ee18d2",
      "bytes": 16704,
      "at": "2026-08-21T00:35:47.898Z"
    },
    "0-014": {
      "id": "story:0:14",
      "text": "Hjertet banker, fordi familien skal rejse i dag.",
      "stamp": "2beb4ed78f58e468",
      "bytes": 14496,
      "at": "2026-08-21T00:35:48.892Z"
    },
    "0-015": {
      "id": "story:0:15",
      "text": "De går ned ad en gade midt i en gammel by.",
      "stamp": "ed7acddba7333b45",
      "bytes": 11424,
      "at": "2026-08-21T00:35:49.764Z"
    },
    "0-016": {
      "id": "story:0:16",
      "text": "En ung kvinde og en gammel mand venter ved en kirke.",
      "stamp": "71370d5b3a782357",
      "bytes": 15744,
      "at": "2026-08-21T00:35:50.774Z"
    },
    "0-017": {
      "id": "story:0:17",
      "text": "I en butik køber de kød, fisk og grøntsager.",
      "stamp": "31fcee39260d697f",
      "bytes": 12864,
      "at": "2026-08-21T00:35:51.420Z"
    },
    "0-018": {
      "id": "story:0:18",
      "text": "De tager også en kartoffel, sukker og en stor kage.",
      "stamp": "27536d524b06e998",
      "bytes": 13632,
      "at": "2026-08-21T00:35:52.355Z"
    },
    "0-019": {
      "id": "story:0:19",
      "text": "Far henter penge i en bank, fordi han vil købe en bog.",
      "stamp": "58753f1d1072c22a",
      "bytes": 13824,
      "at": "2026-08-21T00:35:52.916Z"
    },
    "0-020": {
      "id": "story:0:20",
      "text": "Mor arbejder på et hospital, men i dag har hun fri.",
      "stamp": "cbe5ce2c48226593",
      "bytes": 14112,
      "at": "2026-08-21T00:35:53.845Z"
    },
    "0-021": {
      "id": "story:0:21",
      "text": "Hendes bror er lærer på en skole.",
      "stamp": "b04d72747f461cb2",
      "bytes": 8832,
      "at": "2026-08-21T00:35:54.618Z"
    },
    "0-022": {
      "id": "story:0:22",
      "text": "Hans søster kører en rød bil, og hendes søn har en cykel.",
      "stamp": "20f841444f97b83b",
      "bytes": 16416,
      "at": "2026-08-21T00:35:55.423Z"
    },
    "0-023": {
      "id": "story:0:23",
      "text": "En hest står i en park ved vandet.",
      "stamp": "d2b54acbab68b954",
      "bytes": 8352,
      "at": "2026-08-21T00:35:56.396Z"
    },
    "0-024": {
      "id": "story:0:24",
      "text": "Deres datter og en ven læser en bog, hvis det regner.",
      "stamp": "d835c8b5fb523e02",
      "bytes": 16992,
      "at": "2026-08-21T00:35:57.491Z"
    },
    "0-025": {
      "id": "story:0:25",
      "text": "En aften i sidste uge faldt der sne over hele byen.",
      "stamp": "47bc194c2decdb3b",
      "bytes": 14784,
      "at": "2026-08-21T00:35:58.438Z"
    },
    "0-026": {
      "id": "story:0:26",
      "text": "Nu venter et tog, og en bus kører forbi.",
      "stamp": "6355ed1bc56e84f5",
      "bytes": 10944,
      "at": "2026-08-21T00:35:59.322Z"
    },
    "0-027": {
      "id": "story:0:27",
      "text": "Fra vinduet ser de stranden og et stort hav.",
      "stamp": "6654b649b325eac9",
      "bytes": 13152,
      "at": "2026-08-21T00:36:00.224Z"
    },
    "0-028": {
      "id": "story:0:28",
      "text": "Det bliver nat, og man kan se månen og en klar stjerne.",
      "stamp": "e083cc6b8d9a031f",
      "bytes": 13632,
      "at": "2026-08-21T00:36:00.908Z"
    },
    "0-029": {
      "id": "story:0:29",
      "text": "De elsker at rejse, selvom rejsen er lang.",
      "stamp": "c757641fb96482fa",
      "bytes": 12864,
      "at": "2026-08-21T00:36:01.581Z"
    },
    "0-030": {
      "id": "story:0:30",
      "text": "Casey er glad, fordi kufferten er fuld af ord.",
      "stamp": "843888799df868f3",
      "bytes": 11712,
      "at": "2026-08-21T00:36:02.201Z"
    }
  },
  "provider": "google",
